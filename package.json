{
  "name": "@pushgenius/javascript",
  "version": "0.1.1",
  "description": "PushGenius server SDK: send push notifications and manage users from Node.js, Bun or Deno",
  "license": "MIT",
  "author": "PushGenius",
  "homepage": "https://pushgeni.us/docs/api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PushGenius/js-sdk.git"
  },
  "keywords": ["push notifications", "pushgenius", "apns", "fcm", "web push"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
